# Variáveis de ambiente — TenisFree
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA versione o arquivo .env com credenciais reais.

# ── Flask ──────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ── Segurança ──────────────────────────────────────────────────────────
# Gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-forte

# ── Banco de dados ─────────────────────────────────────────────────────
# SQLite (padrão para desenvolvimento local):
DATABASE_URL=sqlite:///tenisfree.db

# PostgreSQL (produção — descomente e ajuste):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/tenisfree

# MySQL (alternativo — descomente e ajuste):
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/tenisfree
